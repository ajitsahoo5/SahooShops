{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "sahoo-shop",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".env.local",
        ".env.*.local",
        ".emulator-data",
        ".cursor",
        "coverage",
        "test-results",
        "playwright-report",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firestore-debug.log",
        "ui-debug.log"
      ]
    }
  ],
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": false
  }
}
