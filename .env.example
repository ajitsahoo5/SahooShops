# Copy to .env.local for local development.

# Firebase web app config (public, safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sahoo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sahoo
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Set to "true" to point the browser Auth SDK at the local Auth emulator.
NEXT_PUBLIC_USE_AUTH_EMULATOR=true
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Server-side Firebase Admin settings.
FIREBASE_PROJECT_ID=demo-sahoo
FIREBASE_STORAGE_BUCKET=demo-sahoo.appspot.com

# Local emulators (remove these three lines to use a real project).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Only needed when running against a real project outside Google Cloud.
# Base64-encoded service account JSON. Never commit this value.
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Session cookie lifetime in days (max 14).
SESSION_MAX_AGE_DAYS=5
